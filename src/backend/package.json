{
  "name": "flask-backend",
  "version": "1.0.0",
  "description": "Flask backend for Svelte + Flask template",
  "main": "app.py",
  "scripts": {
    "start": "python app.py",
    "dev": "python app.py",
    "migrate": "python manage.py db migrate",
    "upgrade": "python manage.py db upgrade",
    "test": "pytest",
    "lint": "flake8 .",
    "format": "black ."
  },
  "keywords": [
    "flask",
    "python",
    "api",
    "backend",
    "template"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "Flask": "3.0.3",
    "Flask-SQLAlchemy": "3.1.1",
    "Flask-JWT-Extended": "4.6.0",
    "Flask-CORS": "4.0.0",
    "Werkzeug": "3.0.1",
    "python-dotenv": "1.0.1",
    "requests": "2.32.3"
  },
  "devDependencies": {
    "pytest": "7.4.3",
    "pytest-flask": "1.3.0",
    "pytest-cov": "4.1.0",
    "black": "23.11.0",
    "flake8": "6.1.0",
    "mypy": "1.7.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}